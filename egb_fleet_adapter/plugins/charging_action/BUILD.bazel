load("@com_github_mvukov_rules_ros2//ros2:plugin.bzl", "ros2_plugin")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hdrs",
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
)

# rules_ros2 ros2_plugin produces a dynamic library AND registers it in the
# ament_index resource tree so pluginlib::ClassLoader at runtime can locate
# and load it via package + base-class lookup.
ros2_plugin(
    name = "charging_action_plugin",
    srcs = ["src/charging_action.cpp"],
    plugin_specs = [
        {
            "class_type": "egb_fleet::plugins::ChargingActionFactory",
            "base_class_type": "egb_fleet::action::RobotActionFactory",
        },
    ],
    deps = [
        ":hdrs",
        "//egb_fleet_adapter",
        "@pluginlib",
        "@rmf_ros2//:rmf_fleet_adapter",
        "@ros2_rclcpp//:rclcpp",
    ],
)
