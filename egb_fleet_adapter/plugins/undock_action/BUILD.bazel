load("@com_github_mvukov_rules_ros2//ros2:plugin.bzl", "ros2_plugin")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hdrs",
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
)

# Depends on :action_api rather than the whole adapter, same as an out-of-tree
# plugin would. If this stops building, the ABI has grown a hole.
ros2_plugin(
    name = "undock_action_plugin",
    srcs = ["src/undock_action.cpp"],
    plugin_specs = [
        {
            "class_type": "egb_fleet::plugins::UndockActionFactory",
            "base_class_type": "egb_fleet::action::RobotActionFactory",
        },
    ],
    deps = [
        ":hdrs",
        "//egb_fleet_adapter:action_api",
        "@pluginlib",
        "@ros2_geometry2//:cpp_tf2_geometry_msgs",
        "@ros2_geometry2//:tf2",
    ],
)
