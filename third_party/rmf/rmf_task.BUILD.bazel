"""BUILD file for @rmf_task (open-rmf/rmf_task 2.9.0).

The repo ships two libraries:
  rmf_task          — task allocation / cost-model core (31 cpp files)
  rmf_task_sequence — sequence-based task descriptions (18 cpp files; uses
                      rmf_api_msgs schemas + nlohmann_json_schema_validator)
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rmf_task",
    srcs = glob([
        "rmf_task/src/**/*.cpp",
        "rmf_task/src/**/*.hpp",
    ]),
    hdrs = glob(["rmf_task/include/rmf_task/**/*.hpp"]),
    includes = ["rmf_task/include"],
    linkopts = ["-pthread"],
    deps = [
        "@eigen",
        "@nlohmann_json//:json",
        "@rmf_battery",
        "@rmf_traffic",
        "@rmf_utils",
    ],
)

# rmf_task_sequence also uses rmf_api_generate_schema_headers internally for
# its backup schemas. Only 2 schemas in this package; embed each via genrule.
_TASK_SEQ_SCHEMAS = [
    "backup_EventSequence_v0_1",
    "backup_PhaseSequenceTask_v0_1",
]

[
    genrule(
        name = "task_seq_schema_" + name + "_hpp",
        srcs = ["rmf_task_sequence/schemas/backup/" + name + ".schema.json"],
        outs = ["rmf_task_sequence/gen/rmf_task_sequence/schemas/" + name + ".hpp"],
        cmd = (
            "upper=$$(echo " + name + " | tr '[:lower:]' '[:upper:]') && " +
            "{ echo '/* Generated by Bazel from " + name + ".schema.json */'; " +
            "  echo \"#ifndef RMF_TASK_SEQUENCE__SCHEMAS__$$upper\"; " +
            "  echo \"#define RMF_TASK_SEQUENCE__SCHEMAS__$$upper\"; " +
            "  echo '#include <nlohmann/json.hpp>'; " +
            "  echo 'namespace rmf_task_sequence { namespace schemas {'; " +
            "  echo 'static const nlohmann::json " + name + " ='; " +
            "  echo 'R\"raw_schema('; " +
            "  cat $<; " +
            "  echo ')raw_schema\"_json;'; " +
            "  echo '}}'; " +
            "  echo \"#endif // RMF_TASK_SEQUENCE__SCHEMAS__$$upper\"; " +
            "} > $@"
        ),
    )
    for name in _TASK_SEQ_SCHEMAS
]

cc_library(
    name = "rmf_task_sequence",
    srcs = glob([
        "rmf_task_sequence/src/**/*.cpp",
        "rmf_task_sequence/src/**/*.hpp",
    ]),
    hdrs = glob(["rmf_task_sequence/include/rmf_task_sequence/**/*.hpp"]) + [
        ":task_seq_schema_" + name + "_hpp"
        for name in _TASK_SEQ_SCHEMAS
    ],
    includes = [
        "rmf_task_sequence/gen",
        "rmf_task_sequence/include",
    ],
    deps = [
        ":rmf_task",
        "@nlohmann_json//:json",
        "@nlohmann_json_schema_validator",
        "@rmf_api_msgs",
    ],
)
