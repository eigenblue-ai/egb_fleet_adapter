"""BUILD file for @rmf_traffic (open-rmf/rmf_traffic 3.7.0).

The repo bundles a vendored FCL 0.6 under thirdparty/fcl/ — we expose two
cc_library targets, `:fcl` (collision detection, PRIVATE dep of rmf_traffic)
and `:rmf_traffic` (the RMF traffic library itself).

Generated headers (originally produced by CMake's configure_file /
generate_export_header) are emitted by genrules:
  fcl/config.h  — from include/fcl/config.h.in (no SSE / OCTOMAP / PROFILING)
  fcl/export.h  — hand-written visibility macros (no symbol hiding)
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# FCL — vendored under thirdparty/fcl/
# ---------------------------------------------------------------------------

# Inside the archive, the ROS2 package lives at rmf_traffic/ and FCL is
# vendored at rmf_traffic/thirdparty/fcl/.
_FCL = "rmf_traffic/thirdparty/fcl"

# Generate fcl/config.h. config.h.in uses @VAR@ and #cmakedefine01.
# We disable SSE (no auto-vectorization), OCTOMAP (no optional dep), and
# PROFILING. FCL_VERSION fixed to vendored "0.6.1".
genrule(
    name = "fcl_config_h",
    srcs = [_FCL + "/include/fcl/config.h.in"],
    outs = [_FCL + "/include/fcl/config.h"],
    cmd = "sed -e 's|@FCL_VERSION@|0.6.1|g' " +
          "    -e 's|@FCL_MAJOR_VERSION@|0|g' " +
          "    -e 's|@FCL_MINOR_VERSION@|6|g' " +
          "    -e 's|@FCL_PATCH_VERSION@|1|g' " +
          "    -e 's|#cmakedefine01 FCL_HAVE_SSE|#define FCL_HAVE_SSE 0|g' " +
          "    -e 's|#cmakedefine01 FCL_HAVE_OCTOMAP|#define FCL_HAVE_OCTOMAP 0|g' " +
          "    -e 's|#cmakedefine01 FCL_ENABLE_PROFILING|#define FCL_ENABLE_PROFILING 0|g' " +
          "    -e 's|@GENERATED_FILE_MARKER@|This file is generated by Bazel.|g' " +
          "    $< > $@",
)

# Hand-written fcl/export.h — equivalent to CMake's generate_export_header
# with FCL_STATIC_DEFINE in effect (we build a static library). Macros expand
# to nothing, but must exist so headers referencing them parse.
genrule(
    name = "fcl_export_h",
    outs = [_FCL + "/include/fcl/export.h"],
    cmd = """cat > $@ <<'EOF'
#ifndef FCL_EXPORT_H
#define FCL_EXPORT_H

/* Bazel build: static library; no symbol-visibility decoration needed. */
#define FCL_EXPORT
#define FCL_NO_EXPORT
#define FCL_DEPRECATED __attribute__((__deprecated__))
#define FCL_DEPRECATED_EXPORT FCL_DEPRECATED
#define FCL_DEPRECATED_NO_EXPORT FCL_DEPRECATED

#endif /* FCL_EXPORT_H */
EOF""",
)

cc_library(
    name = "fcl",
    srcs = glob([_FCL + "/src/**/*.cpp"]),
    hdrs = glob([
        _FCL + "/include/fcl/**/*.h",
        _FCL + "/include/fcl/**/*-inl.h",
    ]) + [
        ":fcl_config_h",
        ":fcl_export_h",
    ],
    copts = [
        # Tolerate the warnings rmf_traffic's vendored copy ships with.
        "-Wno-deprecated-declarations",
        "-Wno-unused-parameter",
        "-Wno-maybe-uninitialized",
    ],
    defines = ["FCL_STATIC_DEFINE"],
    includes = [_FCL + "/include"],
    deps = [
        "@ccd",
        "@eigen",
    ],
)

# ---------------------------------------------------------------------------
# rmf_traffic itself
# ---------------------------------------------------------------------------

cc_library(
    name = "rmf_traffic",
    srcs = glob([
        "rmf_traffic/src/**/*.cpp",
        "rmf_traffic/src/**/*.hpp",
        "rmf_traffic/src/**/*.h",
    ]),
    hdrs = glob([
        "rmf_traffic/include/rmf_traffic/**/*.hpp",
        "rmf_traffic/include/rmf_traffic/**/*.h",
    ]),
    defines = ["RMF_TRAFFIC__USING_FCL_0_6"],
    includes = ["rmf_traffic/include"],
    linkopts = ["-pthread"],
    deps = [
        ":fcl",
        "@eigen",
        "@rmf_utils",
    ],
)
