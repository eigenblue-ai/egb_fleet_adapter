"""BUILD file for the @rmf_internal_msgs repository (open-rmf/rmf_internal_msgs).

The repo bundles a dozen RMF ROS2 interface packages. We expose each as its own
ros2_interface_library target so downstream cc/py code can depend on exactly
what it needs.

Inter-package deps (read from each package.xml):
  rmf_dispenser_msgs -> (none)
  rmf_ingestor_msgs  -> rmf_dispenser_msgs
  rmf_task_msgs      -> rmf_dispenser_msgs
  all others         -> (only builtin/external)

External msg deps: builtin_interfaces (Time/Duration is referenced by most
RMF msg files), geometry_msgs, std_msgs.
"""

load(
    "@com_github_mvukov_rules_ros2//ros2:interfaces.bzl",
    "cpp_ros2_interface_library",
    "py_ros2_interface_library",
    "ros2_interface_library",
)

package(default_visibility = ["//visibility:public"])

BUILTIN = "@ros2_rcl_interfaces//:builtin_interfaces"

GEOMETRY = "@ros2_common_interfaces//:geometry_msgs"

STD = "@ros2_common_interfaces//:std_msgs"

ACTION = "@ros2_rcl_interfaces//:action_msgs"

# -- Leaf packages (no inter-rmf_internal_msgs deps) ------------------------

ros2_interface_library(
    name = "rmf_charger_msgs",
    srcs = glob(["rmf_charger_msgs/msg/*.msg"]),
    deps = [BUILTIN],
)

ros2_interface_library(
    name = "rmf_dispenser_msgs",
    srcs = glob(["rmf_dispenser_msgs/msg/*.msg"]),
    deps = [
        BUILTIN,
        GEOMETRY,
    ],
)

ros2_interface_library(
    name = "rmf_door_msgs",
    srcs = glob(["rmf_door_msgs/msg/*.msg"]),
    deps = [BUILTIN],
)

ros2_interface_library(
    name = "rmf_fleet_msgs",
    srcs = glob([
        "rmf_fleet_msgs/msg/*.msg",
        "rmf_fleet_msgs/srv/*.srv",
    ]),
    deps = [BUILTIN],
)

ros2_interface_library(
    name = "rmf_lift_msgs",
    srcs = glob(["rmf_lift_msgs/msg/*.msg"]),
    deps = [BUILTIN],
)

ros2_interface_library(
    name = "rmf_obstacle_msgs",
    srcs = glob(["rmf_obstacle_msgs/msg/*.msg"]),
    deps = [
        BUILTIN,
        GEOMETRY,
        STD,
    ],
)

ros2_interface_library(
    name = "rmf_scheduler_msgs",
    srcs = glob([
        "rmf_scheduler_msgs/msg/*.msg",
        "rmf_scheduler_msgs/srv/*.srv",
    ]),
    deps = [BUILTIN],
)

ros2_interface_library(
    name = "rmf_traffic_msgs",
    srcs = glob([
        "rmf_traffic_msgs/msg/*.msg",
        "rmf_traffic_msgs/srv/*.srv",
    ]),
    deps = [
        BUILTIN,
        GEOMETRY,
    ],
)

ros2_interface_library(
    name = "rmf_workcell_msgs",
    srcs = glob(["rmf_workcell_msgs/msg/*.msg"]),
    deps = [BUILTIN],
)

ros2_interface_library(
    name = "rmf_site_map_msgs",
    srcs = glob(["rmf_site_map_msgs/msg/*.msg"]),
    deps = [BUILTIN],
)

# -- Packages with intra-repo deps -----------------------------------------

ros2_interface_library(
    name = "rmf_ingestor_msgs",
    srcs = glob(["rmf_ingestor_msgs/msg/*.msg"]),
    deps = [
        ":rmf_dispenser_msgs",
        BUILTIN,
        GEOMETRY,
    ],
)

ros2_interface_library(
    name = "rmf_task_msgs",
    srcs = glob([
        "rmf_task_msgs/msg/*.msg",
        "rmf_task_msgs/srv/*.srv",
        "rmf_task_msgs/action/*.action",
    ]),
    deps = [
        ":rmf_dispenser_msgs",
        ACTION,
        BUILTIN,
    ],
)

# -- C++ and Python convenience aggregates (per-package) -------------------

_PACKAGES = [
    "rmf_charger_msgs",
    "rmf_dispenser_msgs",
    "rmf_door_msgs",
    "rmf_fleet_msgs",
    "rmf_ingestor_msgs",
    "rmf_lift_msgs",
    "rmf_obstacle_msgs",
    "rmf_scheduler_msgs",
    "rmf_site_map_msgs",
    "rmf_task_msgs",
    "rmf_traffic_msgs",
    "rmf_workcell_msgs",
]

[
    cpp_ros2_interface_library(
        name = "cpp_" + pkg,
        deps = [":" + pkg],
    )
    for pkg in _PACKAGES
]

[
    py_ros2_interface_library(
        name = "py_" + pkg,
        deps = [":" + pkg],
    )
    for pkg in _PACKAGES
]
