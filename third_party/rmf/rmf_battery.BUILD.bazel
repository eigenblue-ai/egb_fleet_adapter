"""BUILD file for @rmf_battery (open-rmf/rmf_battery 0.5.0).

Small library — 5 source files under src/rmf_battery/agv/, headers under
include/rmf_battery/. Links rmf_utils + rmf_traffic + Eigen3.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "rmf_battery",
    srcs = glob([
        "rmf_battery/src/**/*.cpp",
        "rmf_battery/src/**/*.hpp",
    ]),
    hdrs = glob(["rmf_battery/include/rmf_battery/**/*.hpp"]),
    includes = ["rmf_battery/include"],
    deps = [
        "@eigen",
        "@rmf_traffic",
        "@rmf_utils",
    ],
)
