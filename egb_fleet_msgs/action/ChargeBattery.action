# GOAL
string robot_id
float32 target_soc
float32 timeout

---

# RESULT
bool success
float32 final_soc
int8 error_code
int8 SUCCESS = 0
int8 TIMEOUT = -1
int8 HARDWARE_ERROR = -2
int8 BATTERY_NOT_FOUND = -3
string error_message

---

# FEEDBACK
float32 current_soc
float32 target_soc
float32 charging_rate
