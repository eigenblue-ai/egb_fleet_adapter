# GOAL
int8 operation
int8 LIFT_UP = 1
int8 LIFT_DOWN = 0
float64 timeout
string car_location
string car_name
string robot_name

---

# RESULT
bool success
int8 error_code
int8 SUCCESS = 0
int8 TIMEOUT = -1
int8 HARDWARE_ERROR = -2
int8 INVALID_OPERATION = -3
string error_message

---

# FEEDBACK
string status
float64 progress
float64 estimated_time_remaining
